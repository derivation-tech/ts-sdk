{
    "name": "@derivation-tech/viem-ledger",
    "version": "0.2.1",
    "description": "Ledger helpers for viem accounts",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "pnpm run clean && tsc -p tsconfig.json",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "test": "node --test tests/*.test.cjs",
        "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,cjs}\" \"*.{json,md}\"",
        "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,cjs}\" \"*.{json,md}\"",
        "verify": "pnpm run lint && pnpm run format:check && pnpm run build && pnpm run verify:checks",
        "prepack": "pnpm run build",
        "lint": "eslint . --max-warnings=0",
        "verify:checks": "pnpm run verify:compatibility && pnpm run publint && pnpm run attw",
        "publint": "publint --pack npm",
        "attw": "npm --ignore-scripts exec -- attw --pack . --entrypoints .",
        "verify:compatibility": "node scripts/verify-compatibility.cjs"
    },
    "dependencies": {
        "@ledgerhq/device-management-kit": "1.9.1",
        "@ledgerhq/device-signer-kit-ethereum": "1.18.1",
        "@ledgerhq/device-transport-kit-node-hid": "1.0.1",
        "@ledgerhq/context-module": "^2.6.0",
        "rxjs": "7.8.2"
    },
    "devDependencies": {
        "viem": "catalog:",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "prettier": "catalog:",
        "publint": "0.3.24",
        "@arethetypeswrong/cli": "0.18.5"
    },
    "peerDependencies": {
        "viem": "^2.43.3"
    },
    "engines": {
        "node": ">=22"
    },
    "type": "commonjs"
}
