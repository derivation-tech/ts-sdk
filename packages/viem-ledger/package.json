{
    "name": "@derivation-tech/viem-ledger",
    "version": "0.2.1",
    "description": "Ledger helpers for viem accounts",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rm -rf dist",
        "prepublishOnly": "npm run build",
        "test": "node --test tests/*.test.cjs",
        "format": "prettier --write \"{src,tests}/**/*.{ts,cjs}\" \"*.{json,md}\"",
        "format:check": "prettier --check \"{src,tests}/**/*.{ts,cjs}\" \"*.{json,md}\"",
        "verify": "pnpm run format:check && pnpm run test"
    },
    "dependencies": {
        "@ledgerhq/hw-app-eth": "^6.32.0",
        "@ledgerhq/hw-transport": "^6.31.14",
        "@ledgerhq/hw-transport-node-hid": "^6.27.12"
    },
    "devDependencies": {
        "viem": "catalog:",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "prettier": "catalog:"
    },
    "peerDependencies": {
        "viem": "^2.43.3"
    },
    "engines": {
        "node": ">=22"
    }
}
