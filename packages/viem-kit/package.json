{
    "name": "@derivation-tech/viem-kit",
    "version": "0.2.2",
    "description": "Viem-based web3 kit with address book, contract parsers, and tx handling",
    "type": "commonjs",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            },
            "default": "./dist/index.mjs"
        },
        "./abis": {
            "import": {
                "types": "./dist/abis/index.d.mts",
                "default": "./dist/abis/index.mjs"
            },
            "require": {
                "types": "./dist/abis/index.d.ts",
                "default": "./dist/abis/index.cjs"
            },
            "default": "./dist/abis/index.mjs"
        },
        "./contracts": {
            "import": {
                "types": "./dist/contracts/index.d.mts",
                "default": "./dist/contracts/index.mjs"
            },
            "require": {
                "types": "./dist/contracts/index.d.ts",
                "default": "./dist/contracts/index.cjs"
            },
            "default": "./dist/contracts/index.mjs"
        },
        "./utils": {
            "import": {
                "types": "./dist/utils/index.d.mts",
                "default": "./dist/utils/index.mjs"
            },
            "require": {
                "types": "./dist/utils/index.d.ts",
                "default": "./dist/utils/index.cjs"
            },
            "default": "./dist/utils/index.mjs"
        },
        "./node": {
            "import": {
                "types": "./dist/node/index.d.mts",
                "default": "./dist/node/index.mjs"
            },
            "require": {
                "types": "./dist/node/index.d.ts",
                "default": "./dist/node/index.cjs"
            },
            "default": "./dist/node/index.mjs"
        }
    },
    "typesVersions": {
        "*": {
            "abis": [
                "dist/abis/index.d.ts"
            ],
            "contracts": [
                "dist/contracts/index.d.ts"
            ],
            "utils": [
                "dist/utils/index.d.ts"
            ],
            "node": [
                "dist/node/index.d.ts"
            ]
        }
    },
    "files": [
        "dist",
        "README.md",
        "docs"
    ],
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "tsdown --config tsdown.config.mts && tsc -p tsconfig.types.json && node scripts/create-esm-declarations.mjs",
        "build:clean": "pnpm run build",
        "build:bundle": "tsdown --config tsdown.config.mts",
        "build:types": "tsc -p tsconfig.types.json && node scripts/create-esm-declarations.mjs",
        "build:check": "tsc --noEmit -p tsconfig.json",
        "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
        "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
        "typecheck:consumer": "tsc --noEmit -p tests/consumer-node-next/tsconfig.json",
        "verify:types": "pnpm run build:check && pnpm run typecheck:test && pnpm run typecheck:examples && pnpm run typecheck:build",
        "test": "jest --config jest.config.cjs --runInBand",
        "format": "prettier --write \"{src,tests,examples,scripts,docs}/**/*.{ts,cts,mts,js,cjs,mjs,json,md}\" \"*.{ts,cts,mts,js,cjs,mjs,json,md}\"",
        "format:check": "prettier --check \"{src,tests,examples,scripts,docs}/**/*.{ts,cts,mts,js,cjs,mjs,json,md}\" \"*.{ts,cts,mts,js,cjs,mjs,json,md}\"",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "publint": "publint --pack npm",
        "attw": "npm --ignore-scripts exec -- attw --pack .",
        "verify": "pnpm run lint && pnpm run format:check && pnpm run build && pnpm run verify:checks",
        "pack": "npm pack",
        "prepack": "pnpm run build:clean && pnpm run build:check",
        "postpublish": "node ../../scripts/slack-notify.js",
        "verify:consumer": "node scripts/verify-consumer.mjs",
        "test:unit": "jest --config jest.config.cjs --runInBand tests/unit",
        "test:integration": "jest --config jest.config.cjs --runInBand tests/integration",
        "typecheck:build": "tsc --noEmit --module nodenext --target es2022 --skipLibCheck tsdown.config.mts",
        "verify:checks": "pnpm run verify:types && pnpm run test && pnpm run typecheck:consumer && pnpm run verify:consumer && pnpm run publint && pnpm run attw"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@derivation-tech/viem-ledger": "workspace:*",
        "@jest/globals": "catalog:",
        "@types/node": "catalog:",
        "jest": "catalog:",
        "prettier": "catalog:",
        "publint": "0.3.24",
        "ts-jest": "catalog:",
        "typescript": "catalog:",
        "viem": "catalog:",
        "tsdown": "0.23.0",
        "esbuild": "0.28.2"
    },
    "peerDependencies": {
        "@derivation-tech/viem-ledger": "^0.2.1",
        "viem": "^2.43.3"
    },
    "peerDependenciesMeta": {
        "@derivation-tech/viem-ledger": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "viem",
        "web3",
        "ethereum",
        "context",
        "blockchain"
    ]
}
