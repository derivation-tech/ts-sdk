{
    "name": "@derivation-tech/viem-kit",
    "version": "0.2.2",
    "description": "Viem-based web3 kit with address book, contract parsers, and tx handling",
    "type": "commonjs",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            },
            "default": "./dist/index.mjs"
        },
        "./abis": {
            "import": {
                "types": "./dist/abis/index.d.mts",
                "default": "./dist/abis/index.mjs"
            },
            "require": {
                "types": "./dist/abis/index.d.ts",
                "default": "./dist/abis/index.cjs"
            },
            "default": "./dist/abis/index.mjs"
        },
        "./contracts": {
            "import": {
                "types": "./dist/contracts/index.d.mts",
                "default": "./dist/contracts/index.mjs"
            },
            "require": {
                "types": "./dist/contracts/index.d.ts",
                "default": "./dist/contracts/index.cjs"
            },
            "default": "./dist/contracts/index.mjs"
        },
        "./utils": {
            "import": {
                "types": "./dist/utils/index.d.mts",
                "default": "./dist/utils/index.mjs"
            },
            "require": {
                "types": "./dist/utils/index.d.ts",
                "default": "./dist/utils/index.cjs"
            },
            "default": "./dist/utils/index.mjs"
        },
        "./chains": {
            "import": {
                "types": "./dist/chains/index.d.mts",
                "default": "./dist/chains/index.mjs"
            },
            "require": {
                "types": "./dist/chains/index.d.ts",
                "default": "./dist/chains/index.cjs"
            },
            "default": "./dist/chains/index.mjs"
        },
        "./node": {
            "import": {
                "types": "./dist/node/index.d.mts",
                "default": "./dist/node/index.mjs"
            },
            "require": {
                "types": "./dist/node/index.d.ts",
                "default": "./dist/node/index.cjs"
            },
            "default": "./dist/node/index.mjs"
        }
    },
    "typesVersions": {
        "*": {
            "abis": [
                "dist/abis/index.d.ts"
            ],
            "contracts": [
                "dist/contracts/index.d.ts"
            ],
            "utils": [
                "dist/utils/index.d.ts"
            ],
            "chains": [
                "dist/chains/index.d.ts"
            ],
            "node": [
                "dist/node/index.d.ts"
            ]
        }
    },
    "files": [
        "dist",
        "README.md",
        "MIGRATION.md"
    ],
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "tsup --config tsup.config.ts && tsc -p tsconfig.types.json && node scripts/create-esm-declarations.mjs",
        "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup --config tsup.config.ts && tsc -p tsconfig.types.json && node scripts/create-esm-declarations.mjs",
        "build:bundle": "tsup --config tsup.config.ts",
        "build:types": "tsc -p tsconfig.types.json && node scripts/create-esm-declarations.mjs",
        "build:check": "tsc --noEmit -p tsconfig.json",
        "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
        "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
        "typecheck:consumer": "tsc --noEmit -p tests/consumer-node-next/tsconfig.json",
        "verify:types": "pnpm run build:check && pnpm run typecheck:test && pnpm run typecheck:examples",
        "test": "jest --config jest.config.cjs",
        "format": "prettier --write \"{src,tests,examples,scripts}/**/*.{ts,js,cjs,mjs,json,md}\" \"*.{ts,js,cjs,mjs,json,md}\"",
        "format:check": "prettier --check \"{src,tests,examples,scripts}/**/*.{ts,js,cjs,mjs,json,md}\" \"*.{ts,js,cjs,mjs,json,md}\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "publint": "publint --pack npm",
        "attw": "attw --pack .",
        "verify": "pnpm run lint && pnpm run format:check && pnpm run verify:types && pnpm exec jest --config jest.config.cjs --runInBand && pnpm run build && pnpm run typecheck:consumer && pnpm run verify:consumer && pnpm run publint && pnpm run attw",
        "pack": "npm pack",
        "prepack": "npm run build && npm run build:check",
        "postpublish": "node ../../scripts/slack-notify.js",
        "verify:consumer": "node scripts/verify-consumer.mjs"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@derivation-tech/viem-ledger": "workspace:*",
        "@jest/globals": "^29.7.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.0.0",
        "jest": "^29.7.0",
        "prettier": "catalog:",
        "publint": "0.3.24",
        "ts-jest": "catalog:",
        "tsup": "^8.5.0",
        "typescript": "catalog:",
        "viem": "catalog:"
    },
    "peerDependencies": {
        "@derivation-tech/viem-ledger": "^0.2.1",
        "viem": "^2.43.3"
    },
    "peerDependenciesMeta": {
        "@derivation-tech/viem-ledger": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "viem",
        "web3",
        "ethereum",
        "context",
        "blockchain"
    ]
}
