{
    "name": "@derivation-tech/{PACKAGE}",
    "version": "0.0.1",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,md}\"",
        "lint": "eslint src test",
        "lint:fix": "eslint src test --fix",
        "test": "jest",
        "test:coverage": "jest --coverage=true --coverage-reporters=text",
        "test:ci": "jest --coverage=true --coverage-reporters=json --verbose",
        "test:watch": "pnpm run test --watch",
        "build": "tsc -p tsconfig.build.json",
        "build:check": "tsc --noEmit -p tsconfig.build.json",
        "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{json,md}\""
    },
    "dependencies": {},
    "devDependencies": {
        "@types/jest": "^29.5.12",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "ts-jest": "catalog:",
        "jest": "^29.7.0",
        "prettier": "catalog:"
    },
    "jest": {
        "verbose": true,
        "collectCoverageFrom": [
            "<rootDir>/src/**/*.ts"
        ],
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "./",
        "testEnvironment": "node",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.ts$": [
                "ts-jest",
                {
                    "tsconfig": "<rootDir>/tsconfig.test.json"
                }
            ]
        },
        "testTimeout": 30000
    },
    "files": [
        "dist",
        "README.md"
    ],
    "engines": {
        "node": ">=22"
    }
}
