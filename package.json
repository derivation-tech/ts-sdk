{
    "name": "@derivation-tech/ts-sdk",
    "private": true,
    "version": "0.0.1",
    "description": "Derivation-tech TypeScript SDK monorepo",
    "author": "derivation-tech",
    "license": "MIT",
    "scripts": {
        "preinstall": "node scripts/ensure-pnpm.cjs",
        "test": "pnpm run build && pnpm -r --if-present run test",
        "deps": "pnpm -r i",
        "lint": "eslint",
        "format": "pnpm -r --if-present run format",
        "clean": "pnpm -r clean",
        "release": "changeset publish",
        "release:dry": "changeset status",
        "format:check": "pnpm -r --if-present run format:check",
        "build": "pnpm -r run build",
        "verify": "pnpm run lint && pnpm run build && pnpm -r --if-present run verify"
    },
    "devDependencies": {
        "@changesets/cli": "^2.28.1",
        "@eslint/js": "^9.9.1",
        "@types/jest": "^29.5.12",
        "eslint": "^9.7.0",
        "eslint-config-prettier": "^9.1.0",
        "jest": "^29.7.0",
        "prettier": "catalog:",
        "ts-jest": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "^8.70.0"
    },
    "engines": {
        "node": ">=22",
        "pnpm": ">=10 <11"
    },
    "packageManager": "pnpm@10.34.5"
}
