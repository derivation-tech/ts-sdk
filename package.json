{
    "name": "@derivation-tech/ts-sdk",
    "private": true,
    "version": "0.0.1",
    "description": "Derivation-tech TypeScript SDK monorepo",
    "author": "derivation-tech",
    "license": "MIT",
    "scripts": {
        "preinstall": "node scripts/ensure-pnpm.cjs",
        "test": "pnpm run build && pnpm -r --if-present run test",
        "deps": "pnpm -r i",
        "lint": "eslint . --max-warnings=0",
        "format": "pnpm -r --if-present run format",
        "clean": "pnpm -r clean",
        "release": "changeset publish",
        "release:dry": "changeset status",
        "format:check": "pnpm -r --if-present run format:check",
        "build": "pnpm -r run build",
        "verify": "pnpm run lint && pnpm run format:check && pnpm run test:release && pnpm run build && pnpm -r --if-present run verify:checks",
        "release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts --no-frozen-lockfile",
        "test:release": "node --test scripts/tests/release.test.cjs"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "^8.70.1",
        "globals": "^17.12.0"
    },
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26",
        "pnpm": ">=12.5.1 <13"
    },
    "packageManager": "pnpm@12.5.1"
}
